<Window x:Class="viewfile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViewFile - 文件与说明查看器"
        Height="680"
        Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 第一行：文件夹路径 + 浏览 + 扫描 ========== -->
        <Grid Grid.Row="0"
                Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                    Text="文件夹："
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
            <TextBox Grid.Column="1"
                    x:Name="TxtFolderPath"
                    Margin="0,0,5,0"
                     Text="C:\Windows\System32"
                    VerticalContentAlignment="Center"
                     Height="30"/>
            <Button Grid.Column="2"
                    x:Name="BtnBrowse"
                    Content="浏览..."
                    Width="70"
                    Height="30"
                    Margin="0,0,5,0"
                    Click="BtnBrowse_Click"
                    ToolTip="选择要扫描的文件夹"/>
            <Button Grid.Column="3"
                    x:Name="BtnScan"
                    Content="扫描并关联"
                    Width="100"
                    Height="30"
                    Click="BtnScan_Click"/>
        </Grid>

        <!-- ========== 第二行：过滤条件 + 递归选项 ========== -->
        <Grid Grid.Row="1"
                Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                    Text="过滤："
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
            <TextBox Grid.Column="1"
                    x:Name="TxtFilter"
                    Margin="0,0,15,0"
                     Text="*.exe;*.bat;*.txt"
                    VerticalContentAlignment="Center"
                    Height="28"
                     ToolTip="多个模式用分号隔开，如 *.exe;*.dll;*.txt"/>
            <CheckBox Grid.Column="2"
                    x:Name="ChkRecursive"
                    Content="包含子文件夹"
                      VerticalAlignment="Center"
                    Margin="0,0,15,0"/>
            <TextBlock Grid.Column="3"
                    Text="（zhushi.txt 放在被扫描文件夹根目录）"
                       VerticalAlignment="Center"
                    Foreground="Gray"
                    FontSize="11"/>
        </Grid>

        <!-- ========== 第三行：主内容区（左列表 + 分隔条 + 右说明） ========== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"
                        MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*"
                        MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：文件列表 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                        x:Name="TxtFileCount"
                           Text="共 0 个文件"
                        Foreground="Gray"
                           Margin="0,0,0,5"
                        FontSize="12"/>
                <DataGrid x:Name="FileGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionChanged="FileGrid_SelectionChanged"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F7F7F7"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          MinColumnWidth="60"
                          RowHeight="26"
                          ColumnHeaderHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件名"
                                Binding="{Binding Name}"
                                            Width="*"
                                MinWidth="150"/>
                        <DataGridTextColumn Header="大小 (KB)"
                                Binding="{Binding SizeKB}"
                                            Width="90"
                                SortMemberPath="SizeKB"/>
                        <DataGridTextColumn Header="说明状态"
                                Binding="{Binding HasCommentText}"
                                            Width="90"
                                SortMemberPath="HasCommentText"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1"
                    HorizontalAlignment="Stretch"
                          Background="LightGray"
                    ResizeBehavior="PreviousAndNext"/>

            <!-- 右侧：说明展示 -->
            <Border Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                            Text="文件说明"
                            FontWeight="Bold"
                               FontSize="14"
                            Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                            x:Name="TxtSelectedFileName"
                               Foreground="#555"
                            Margin="0,0,0,10"
                               TextWrapping="Wrap"
                            FontSize="12"/>

                    <Border Grid.Row="2"
                            Background="#FAFAFA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Padding="10"
                            CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtComment"
                                    TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                    FontSize="13"
                                       LineHeight="22"
                                    Foreground="#222"
                                       Text="（请选择左侧文件查看说明）"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 第四行：状态栏 ========== -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                Padding="8,4"
                Margin="0,8,0,0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus"
                    Text="就绪"
                    Foreground="#666"
                    FontSize="11"/>
        </Border>
    </Grid>
</Window>